# Required for the contact form to actually send email. Without these,
# submissions are validated and logged, but not delivered.
#
# GMAIL_USER is the Gmail address the form sends from (and to).
# GMAIL_APP_PASSWORD is a 16-character App Password, NOT your normal Gmail
# password. Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Google account).
GMAIL_USER=
GMAIL_APP_PASSWORD=
